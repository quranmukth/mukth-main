    "react-router-dom": "^7.14.1",
    "socket.io-client": "^4.8.3",
    "wavesurfer.js": "^7.12.6",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
