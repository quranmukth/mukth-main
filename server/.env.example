# ══════════════════════════════════════════════════════════════════
#  Mukth Platform — Production Environment Template
#  Copy to .env and fill in every value before deploying.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────
# EGYPT DNS FIX: 
# If you are in Egypt or using a network that blocks Atlas DNS (+srv), 
# use the "Standard Connection String" format (mongodb://) instead.
#
# Standard (Bypass DNS): mongodb://<user>:<password>@cluster0-shard-00-00.mongodb.net:27017,cluster0-shard-00-01.mongodb.net:27017,cluster0-shard-00-02.mongodb.net:27017/mukth?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Default (DNS dependent): mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mukth?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ATLAS_USER:ATLAS_PASSWORD@cluster0.xxxxx.mongodb.net/mukth?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=7d

# Generate a DIFFERENT secret for refresh tokens
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_HEX_STRING
JWT_REFRESH_EXPIRES_IN=30d

# ── AWS S3 (Audio Storage) ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=mukth-recordings-prod

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Use http://localhost:5173 for local development
FRONTEND_URL=http://localhost:5173,https://mukth.vercel.app

# ── Admin Bootstrap ───────────────────────────────────────────────
# Used only by seed.js — change immediately after first login
ADMIN_EMAIL=admin@mukth.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS

# ── Optional: Logging ─────────────────────────────────────────────
LOG_LEVEL=info
